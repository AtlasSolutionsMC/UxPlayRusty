#define IDOK 1
#define IDCANCEL 2
#define DS_SETFONT 0x0040L
#define DS_MODALFRAME 0x0080L
#define DS_CENTER 0x0800L
#define WS_POPUP 0x80000000L
#define WS_CAPTION 0x00C00000L
#define WS_SYSMENU 0x00080000L
#define WS_CHILD 0x40000000L
#define WS_VISIBLE 0x10000000L
#define WS_TABSTOP 0x00010000L
#define SS_ICON 0x00000003L
#define ES_AUTOHSCROLL 0x0080L

1 ICON "@ICON_PATH@"
1 24 "@MANIFEST_PATH@"

#define IDD_INSTALLER 101
#define IDD_FIXER 102
#define IDC_LOGO 1001
#define IDC_INSTALL_PATH 1002
#define IDC_BROWSE 1003
#define IDC_AUTOSTART 1004
#define IDC_DESKTOP_SHORTCUT 1005
#define IDC_FIXER_STATUS 1006
#define IDC_REPORT 1007
#define IDC_RESET 1008
#define IDC_CHECK_UPDATE 1009
#define IDC_UNINSTALL 1010

IDD_INSTALLER DIALOGEX 0, 0, 360, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "UxPlay Setup"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "", IDC_LOGO, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 12, 12, 56, 56
    LTEXT "UxPlayRusty", -1, 78, 16, 250, 18
    LTEXT "Choose an installation folder and setup options.", -1, 78, 37, 265, 24
    LTEXT "Install location", -1, 12, 78, 100, 12
    EDITTEXT IDC_INSTALL_PATH, 12, 94, 282, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", IDC_BROWSE, 300, 94, 48, 18
    AUTOCHECKBOX "Start UxPlay when I sign in", IDC_AUTOSTART, 12, 125, 220, 14, WS_TABSTOP
    AUTOCHECKBOX "Create a desktop shortcut", IDC_DESKTOP_SHORTCUT, 12, 145, 220, 14, WS_TABSTOP
    DEFPUSHBUTTON "Install", IDOK, 228, 168, 58, 18, WS_TABSTOP
    PUSHBUTTON "Cancel", IDCANCEL, 290, 168, 58, 18, WS_TABSTOP
END

IDD_FIXER DIALOGEX 0, 0, 360, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "UxPlay Fixer"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "", IDC_LOGO, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 12, 12, 56, 56
    LTEXT "UxPlayRusty is already installed.", -1, 78, 16, 255, 18
    LTEXT "Choose a maintenance action:", -1, 78, 37, 255, 18
    PUSHBUTTON "Report an issue on GitHub", IDC_REPORT, 12, 88, 160, 24, WS_TABSTOP
    PUSHBUTTON "Reset to default", IDC_RESET, 12, 120, 160, 24, WS_TABSTOP
    PUSHBUTTON "Check for updates", IDC_CHECK_UPDATE, 188, 88, 160, 24, WS_TABSTOP
    PUSHBUTTON "Uninstall", IDC_UNINSTALL, 188, 120, 160, 24, WS_TABSTOP
    LTEXT "", IDC_FIXER_STATUS, 12, 158, 336, 28
    DEFPUSHBUTTON "Close", IDCANCEL, 290, 190, 58, 18, WS_TABSTOP
END
